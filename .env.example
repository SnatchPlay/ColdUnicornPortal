VITE_SUPABASE_URL=https://bnetnuzxynmdftiadwef.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_6jbWFa2hOX-5U6TWS_KtrQ_5JXYCRG2
VITE_APP_BASE_URL=http://localhost:5175
VITE_APP_ENV=development
VITE_AUTH_INVITE_ONLY=true
VITE_AUTH_ALLOW_SELF_SIGNUP=false
VITE_AUTH_ALLOW_MAGIC_LINK=true

# Data-gateway edge function name. Production uses the single canonical "orm-gateway"
# (the default). Only override in dev to point at a separately-deployed WIP gateway
# during a risky change; leave unset in production.
# See docs/adr/0008-orm-gateway-edge-function.md.
# VITE_ORM_GATEWAY_FUNCTION=orm-gateway-wip

# Legacy CRM-integration Supabase project (separate from the main project).
# Hosts the crm_providers/crm_provider_fields tables and the edge functions
# submit-crm-credentials / zoho-token-exchange / salesforce-oauth that
# broker OAuth + forward credentials to the n8n/Make webhook.
# Leave blank to hide the "CRM Integration" card in client settings.
VITE_LEGACY_CRM_SUPABASE_URL=
VITE_LEGACY_CRM_PUBLISHABLE_KEY=

# ── n8n instance MCP (automation source-of-truth tooling) ─────────────────────────────────────
# Used by `pnpm n8n:*` and by the project-local Claude Code MCP server. Put the real values in
# .env.local (gitignored) — never here, never in .mcp.json.
#
#   N8N_MCP_URL       https://<your-n8n-host>/mcp-server/http   (official instance MCP, n8n >= 1.115)
#   N8N_MCP_API_KEY   an n8n API key (Settings → n8n API). Scoped to the user that created it.
#
# The token currently in use carries workflow:delete / workflow:publish and points at PRODUCTION.
# All tracked tooling is therefore READ-ONLY by default; see docs/reference/n8n/environments.md.
N8N_MCP_URL=
N8N_MCP_API_KEY=

# Which environment N8N_MCP_URL points at: development | staging | production.
# Anything other than "development" makes the write-capable scripts refuse to run.
N8N_ENV=production
