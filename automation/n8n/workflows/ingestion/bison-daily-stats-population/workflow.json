      "parameters": {
        "rule": {
          "interval": [
            {
              "expression": "0 26 */2 * * *",
              "field": "cronExpression"
            }
          ]
        }
      }
    },
    {
      "id": "51991f93-b092-48f5-86fe-611c63765a72",
      "name": "Set Report Date1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -2048,
        -400
      ],
      "parameters": {
        "jsCode": "const incoming = $input.first()?.json || {};\nconst target = incoming.query?.targetDate || incoming.body?.targetDate || incoming.targetDate || null;\nconst dt = target ? new Date(target + 'T12:00:00Z') : new Date();\nconst pad = n => String(n).padStart(2, '0');\nconst y = dt.getUTCFullYear();\nconst m = pad(dt.getUTCMonth() + 1);\nconst d = pad(dt.getUTCDate());\nreturn [{ json: {\n  reportDate: y + '-' + m + '-' + d,\n  firstDayOfMonth: y + '-' + m + '-01',\n  isBackfill: !!target\n} }];"
      }
    },
