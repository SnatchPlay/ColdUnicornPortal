    {
      "id": "a9355f54-ea89-4bea-909d-bec6fdf8c186",
      "name": "Get Active Clients1",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -1824,
        -400
      ],
      "parameters": {
        "operation": "executeQuery",
        "options": {},
        "query": "select c.id,\n       c.name,\n       cs.external_workspace_id,\n       cs.api_key as external_api_key\nfrom public.clients c\njoin public.client_sequencers cs on cs.client_id = c.id and cs.enabled\njoin public.sequencers        s  on s.id = cs.sequencer_id and s.key = 'emailbison'\nwhere c.status = 'Active'\n  and cs.external_workspace_id is not null\n  and coalesce(cs.api_key, '') <> ''\norder by c.name;"
      }
    },
    {
      "id": "8e625d11-f9e6-4471-9ecb-ece4ff938d66",
      "name": "Schedule Trigger1",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
