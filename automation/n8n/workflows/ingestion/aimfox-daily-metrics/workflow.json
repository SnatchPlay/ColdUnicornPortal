    {
      "id": "ea93b87f-7c3d-44a7-bb0e-d1451d07def3",
      "name": "Code in JavaScript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -272
      ],
      "alwaysOutputData": false,
      "parameters": {
        "jsCode": "const toNumber = (value) => {\n  const number = Number(value);\n  return Number.isFinite(number) ? number : 0;\n};\n\nreturn {\n  json: {\n    account_id: $('Filter1').item.json.row_number,\n    workspace_id: $('Filter1').item.json.col_5, \n    campaign_id: $('Filter').item.json.campaigns.id,\n\n    sent: toNumber($json.metrics.sent_connections),\n    accepted: toNumber($json.metrics.accepted_connections),\n    audience: toNumber($('Get Campaign').item.json.campaign.audience_size),\n\n    // приклад показника, який треба віднімати\n    remaining_audience:\n      toNumber($('Get Campaign').item.json.campaign.audience_size) -\n      toNumber($json.metrics.sent_connections)\n  }\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "70ba0401-8d82-4583-b562-53b1d28fada8",
      "name": "Code in JavaScript2",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1600,
        -80
      ],
      "alwaysOutputData": false,
      "parameters": {
        "jsCode": "const toNumber = (value) => {\n  const number = Number(value);\n  return Number.isFinite(number) ? number : 0;\n};\n\nreturn {\n  json: {\n    account_id: $('Filter1').item.json.row_number,\n    daily_limit: toNumber($('Summarize1').item.json.sum_limit_connect)/5,\n    sent_today: toNumber($json.buckets[1].sent_connections-$json.buckets[0].sent_connections),\n    sent_connections: toNumber($json.buckets[1].sent_connections) - $json.buckets[0].sent_connections,\n    workspace_id: $('Filter1').item.json.col_5,\n\n    remaining_limit:\n      toNumber($('Summarize1').item.json.sum_limit_connect)/5 -\n      toNumber($json.buckets[1].sent_connections) -\n      toNumber($json.buckets[0].sent_connections)\n  }\n};",
        "mode": "runOnceForEachItem"
      }
    },
    {
      "id": "f256805a-5d41-4af1-b03e-289a5260d469",
      "name": "Code in JavaScript3",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2928,
        -176
      ],
      "parameters": {
        "jsCode": "const toNumber = (value) => {\n  const number = Number(value);\n  return Number.isFinite(number) ? number : 0;\n};\n\nconst aggregateData = $('Aggregate1').item.json.data || [];\n\nconst accountId =\n  aggregateData[1]?.account_id ??\n  aggregateData[0]?.account_id ??\n  aggregateData[1]?.average_account_id ??\n  aggregateData[0]?.average_account_id ??\n  null;\n\nconst dailyLimit = toNumber(\n  aggregateData[0]?.daily_limit ??\n  aggregateData[1]?.daily_limit\n);\n\nconst remainingAudience = toNumber(aggregateData[0]?.sum_remaining_audience);\n\nconst sentToday = toNumber(\n  aggregateData[0]?.sent_today ??\n  aggregateData[1]?.sent_today\n);\n\nreturn {\n  json: {\n    account_id: accountId,\n\n    schedule_today: Math.min(\n      dailyLimit,\n      remainingAudience + sentToday\n    ),\n\n    schedule_tomorrow: Math.min(\n      dailyLimit,\n      Math.max(remainingAudience - dailyLimit, 0)\n    ),\n\n    schedule_day_after_tomorrow: Math.min(\n      dailyLimit,\n      Math.max(remainingAudience - dailyLimit * 2, 0)\n    ),\n  }\n};",
        "mode": "runOnceForEachItem"
      }
    },
