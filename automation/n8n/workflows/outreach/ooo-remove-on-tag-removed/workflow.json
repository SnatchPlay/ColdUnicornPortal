    {
      "id": "5624567b-a94a-4bd6-a592-bc689361615e",
      "name": "[S] cancel_active_ooo_followup",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        528,
        304
      ],
      "onError": "continueRegularOutput",
      "parameters": {
        "operation": "executeQuery",
        "options": {
          "queryReplacement": "={{ [String($json.event.workspace_id), String($json.data.taggable_id), 'ooo_tag_removed'] }}"
        },
        "query": "select sc.id::text as sequencer_contact_id, f.id::text as cancelled_followup_id, f.status::text as cancelled_status from public.client_sequencers cs join public.sequencer_contacts sc on sc.client_sequencer_id = cs.id and sc.external_contact_id = $2 left join lateral public.cancel_active_ooo_followup(sc.id, $3) f on true where cs.external_workspace_id = $1 and cs.enabled"
      }
    },
