    {
      "id": "eb54a9e5-34db-436e-b227-54f34ce63fbd",
      "name": "Normalize Input (with fallbacks)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        464,
        592
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json || {};\n\nconst pick = (...vals) => {\n  for (const v of vals) {\n    if (v !== undefined && v !== null && String(v).trim() !== \"\") return String(v).trim();\n  }\n  return \"\";\n};\n\nconst capWords = (s) => (s || \"\").split(/[\\s\\-_.]+/).filter(Boolean)\n  .map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(\" \");\n\nconst stripUrl = (raw) => !raw ? \"\" :\n  String(raw).replace(/^https?:\\/\\//, \"\").replace(/^www\\./, \"\").split(\"/\")[0];\n\nconst stripTLD = (host) => {\n  if (!host) return \"\";\n  const parts = String(host).split(\".\");\n  return parts.length > 1 ? parts.slice(0, -1).join(\"-\") : host;\n};\n\nconst email = pick(input.email);\nconst [emailLocal, emailDomainRaw] = email.includes(\"@\") ? email.split(\"@\") : [\"\", \"\"];\nconst emailDomain = emailDomainRaw.toLowerCase();\nconst localParts = emailLocal.split(/[._-]+/).filter(Boolean);\n\nlet derivedFirst = \"\", derivedLast = \"\";\nif (localParts.length >= 2) {\n  derivedFirst = capWords(localParts[0]);\n  derivedLast = capWords(localParts.slice(1).join(\" \"));\n} else if (localParts.length === 1) {\n  derivedFirst = capWords(localParts[0]);\n}\n\nconst firstname = pick(input.firstname, derivedFirst, \"(Unknown)\");\nconst lastname  = pick(input.lastname, derivedLast, capWords(stripTLD(emailDomain)), \"(Unknown)\");\nconst phone     = pick(input.phone);\nconst website   = pick(input.website, emailDomain ? `https://${emailDomain}` : \"\");\nconst company   = pick(\n  input.company,\n  capWords(stripTLD(stripUrl(input.website))),\n  capWords(stripTLD(emailDomain)),\n  \"(Unknown)\"\n);\nconst position  = pick(input.position);\nconst notes     = pick(input.notes);\nconst title     = pick(\n  input.title,\n  `${firstname} ${lastname}`.trim() + (company ? \" @ \" + company : \"\"),\n  \"New Lead\"\n);\nconst created_at  = pick(input.created_at, new Date().toISOString());\nconst workspace_id = pick(input.workspace_id);\nconst last_reply_subject=pick(input.last_reply_subject);\nconst last_reply_body=pick(input.last_reply_body);\nconst last_reply_html=pick(input.last_reply_body_html);\nconst last_reply_created_at=pick(input.last_reply_created_at);\nconst last_reply_to_name=pick(input.last_reply_to_name);\nconst last_reply_to_email=pick(input.last_reply_to_email);\nconst last_reply_message_id=pick(input.last_reply_message_id);\n\nreturn [{ json: { lead: {\n  email, firstname, lastname, phone, company, position, website, notes, title, created_at, workspace_id, last_reply_subject,last_reply_body,last_reply_html,last_reply_created_at,last_reply_to_name,last_reply_to_email,last_reply_message_id\n}}}];"
      }
