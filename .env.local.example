# Local development against the LOCAL Supabase stack (`supabase start`).
# Copy to `.env.local` (Vite auto-loads it and it overrides `.env`). Never commit `.env.local`.
#
# Fill the keys from the `supabase start` output (it prints API URL + anon/publishable key).

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=<anon key from `supabase start`>

# Point the data gateway at the locally-served function.
VITE_ORM_GATEWAY_FUNCTION=orm-gateway

VITE_APP_ENV=development
VITE_APP_BASE_URL=http://127.0.0.1:5173

# Legacy CRM is a separate cloud project — leave blank locally (the CRM card degrades to empty).
VITE_LEGACY_CRM_SUPABASE_URL=
VITE_LEGACY_CRM_PUBLISHABLE_KEY=

# Auth UX flags (defaults shown).
VITE_AUTH_INVITE_ONLY=true
VITE_AUTH_ALLOW_SELF_SIGNUP=false
VITE_AUTH_ALLOW_MAGIC_LINK=true
