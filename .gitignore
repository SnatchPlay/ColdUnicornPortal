# Supabase CLI artifacts + local prod dumps (dumps hold real PII — never commit)
supabase/.temp/
supabase/.branches/
supabase/.local/

# n8n: MCP credentials and per-environment remote IDs stay local (docs/reference/n8n/security.md).
# The tracked artifacts are automation/n8n/** — sanitized workflow JSON only, never a credential.
.mcp.local.json
.n8n.local.json
automation/n8n/environments.local.*
automation/n8n/.exports/

