# Env for locally-served edge functions:  supabase functions serve --env-file supabase/functions/.env.local
# Copy to `supabase/functions/.env.local` (gitignored). Never commit real credentials.
#
# The orm-gateway connects to Postgres with postgres.js. Against the LOCAL stack, point it at the
# local database and disable TLS (local Postgres has none):
DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:54322/postgres?sslmode=disable

# ── Workspace provisioning (ADR-0018) ───────────────────────────────────────────────────────────
# The gateway's ONE outbound capability: triggering a provisioning workflow in n8n. Absent, the
# `requestWorkspaceSetup` action refuses with a 503 rather than silently doing nothing.
#
# The URLs are the n8n webhook paths; the secret is what the receiving webhook's header-auth
# credential checks. Generate it yourself (`openssl rand -hex 32`) and set the SAME value here and
# on the n8n credential. The gateway never holds a vendor key — n8n does (ADR-0018 §1).
N8N_WORKSPACE_SETUP_URL_AIMFOX=https://n8n.coldunicorn.com/webhook/workspace-setup-aimfox
N8N_WORKSPACE_SETUP_URL_BISON=https://n8n.coldunicorn.com/webhook/workspace-setup-bison
N8N_AUTOMATION_SHARED_SECRET=
